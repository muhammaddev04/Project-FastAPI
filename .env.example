# TezFarmo backend settings (copy to backend/.env). Never commit real secrets (SEC-010).
APP_ENV=development
APP_DEBUG=false
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://tezfarmo:tezfarmo@localhost:5433/tezfarmo
REDIS_URL=redis://localhost:6380/0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SEC-003 / SEC-010: at least 32 random bytes each in staging/production.
# APP_SECRET_KEY keys the HMAC of one-time email tokens (P01 §2.2).
APP_SECRET_KEY=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15

# Email delivery (CR-001). EMAIL_PROVIDER=console records messages in memory in development (nothing is sent).
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587 and an app password. Never commit real credentials.
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=
FRONTEND_BASE_URL=http://localhost:5174

# Optional "Continue with Google" (server-side only; never expose to the frontend).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# Private file storage (S3-compatible; SeaweedFS in development). Buckets are never public (SEC-008).
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=tezfarmo
S3_SECRET_KEY=tezfarmo-dev-secret
S3_BUCKET_PRIVATE=tezfarmo-private
S3_SECURE=false

DEFAULT_LANGUAGE=tg
