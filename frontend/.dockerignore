# `COPY . .` runs after `npm ci`, so a local node_modules/ must not be in the context: it would overwrite
# the freshly installed (linux/amd64) dependencies with the host's and break the build.
node_modules/
dist/
.vite/
coverage/
test-results/
playwright-report/

.env
.env.*
!.env.example

*.log
.DS_Store
Thumbs.db

# Image masters are only inputs to scripts/optimize_site_media.py; the generated webp files in
# public/ are committed, so 21 MB of originals never need to enter the build context.
media-masters/
